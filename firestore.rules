rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for hardened validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to extract incoming data
    function incoming() {
      return request.resource.data;
    }

    // Validation helper for User/Account
    function isValidUser(data) {
      return data.keys().hasAll(['ID', 'USERNAME', 'ROLE'])
        && data.ID is string && data.ID.size() <= 100
        && data.USERNAME is string && data.USERNAME.size() <= 64
        && data.ROLE is string && data.ROLE.size() <= 32
        && (!('EMAIL' in data) || (data.EMAIL is string && data.EMAIL.size() <= 120))
        && (!('NAMA' in data) || (data.NAMA is string && data.NAMA.size() <= 150))
        && (!('STATUS' in data) || (data.STATUS is string && data.STATUS.size() <= 32));
    }

    // Validation helper for Asset
    function isValidAsset(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100
        && (!('NAMA_BARANG' in data) || (data.NAMA_BARANG is string && data.NAMA_BARANG.size() <= 200))
        && (!('KODE_BARANG' in data) || (data.KODE_BARANG is string && data.KODE_BARANG.size() <= 100));
    }

    // Validation helper for Inventory Item
    function isValidItem(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100
        && (!('NAMA' in data) || (data.NAMA is string && data.NAMA.size() <= 200))
        && (!('KODE' in data) || (data.KODE is string && data.KODE.size() <= 100));
    }

    // Validation helper for Barang Masuk
    function isValidBarangMasuk(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100;
    }

    // Validation helper for Barang Keluar
    function isValidBarangKeluar(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100;
    }

    // Validation helper for Course
    function isValidCourse(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100;
    }

    // Validation helper for Assignment
    function isValidAssignment(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100;
    }

    // Validation helper for Submission
    function isValidSubmission(data) {
      return data.keys().hasAll(['ID'])
        && data.ID is string && data.ID.size() <= 100;
    }

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Normalized Accounts Collection Rules (Protected against unauthorized deletions and malformed payloads)
    match /accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) && isValidUser(incoming());
      allow delete: if false;
    }

    // Normalized Assets Collection Rules
    match /assets/{assetId} {
      allow read: if true;
      allow create, update: if isValidId(assetId) && isValidAsset(incoming());
      allow delete: if false;
    }

    // Normalized Inventory Items Collection Rules
    match /inventory_items/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId) && isValidItem(incoming());
      allow delete: if false;
    }

    // Normalized Barang Masuk Rules
    match /barang_masuk/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBarangMasuk(incoming());
      allow delete: if false;
    }

    // Normalized Barang Keluar Rules
    match /barang_keluar/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBarangKeluar(incoming());
      allow delete: if false;
    }

    // Normalized Course Rules
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isValidId(courseId) && isValidCourse(incoming());
      allow delete: if false;
    }

    // Normalized Assignment Rules
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidAssignment(incoming());
      allow delete: if false;
    }

    // Normalized Submission Rules
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidId(submissionId) && isValidSubmission(incoming());
      allow delete: if false;
    }

    // Additional Normalized Collections for school management
    match /reports/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /forum_posts/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /attendance/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /quizzes/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /suppliers/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /mutasi/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /pemeliharaan/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /penghapusan/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /pengambilan_atk/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /stock_opname_sessions/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /stock_opname_scans/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /procurement_plans/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /procurement_plan_details/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }
    match /configs/{id} {
      allow read: if true;
      allow create, update: if isValidId(id);
      allow delete: if false;
    }

    // Backward compatibility match for initial bundles
    match /school_data/{bundleId} {
      allow read: if true;
      allow create, update: if isValidId(bundleId);
      allow delete: if false;
    }
  }
}
